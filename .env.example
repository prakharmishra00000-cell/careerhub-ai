# ==============================================================================
# CareerHub AI — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Required)
# ------------------------------------------------------------------------------
# For Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# For Vercel / Production (PostgreSQL - Supabase / Neon / Vercel Postgres / AWS RDS):
# DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (Required in Production)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-32-character-secret-key-here"
AUTH_SECRET="your-32-character-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. AI PROVIDER (Powers Assistant, ATS Resume Review, Roadmap, Match Scoring)
# Provide AT LEAST ONE of the following:
# ------------------------------------------------------------------------------
# Option A: OpenAI API Key (or compatible endpoints)
OPENAI_API_KEY=""
# Option B: Google Gemini API Key
GEMINI_API_KEY=""
# Option C: Groq High-Speed LLM API Key (Free tier available)
GROQ_API_KEY=""
# Option D: OpenRouter API Key
OPENROUTER_API_KEY=""
# Option E: Zhipu AI SDK Key
ZHIPU_API_KEY=""

# Optional Custom AI Model & Endpoint:
# AI_MODEL="gpt-4o-mini"
# AI_BASE_URL="https://api.openai.com/v1"

# ------------------------------------------------------------------------------
# 4. REAL-TIME LIVE JOB PLATFORMS (Connects Real LinkedIn, Indeed, etc.)
# ------------------------------------------------------------------------------
# Enable or disable live jobs aggregation (default: true)
ENABLE_LIVE_JOBS="true"

# Provider 1: RapidAPI JSearch (Aggregates live jobs from LinkedIn, Indeed, Glassdoor, ZipRecruiter)
# Get free/paid key at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=""
JSEARCH_API_KEY=""

# Provider 2: Adzuna Jobs API (Global & India job aggregator)
# Get free developer keys at https://developer.adzuna.com/
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
ADZUNA_COUNTRY="in" # 'in' for India, 'us' for United States, 'gb' for UK, etc.

# Note: Arbeitnow & Remotive live public APIs work automatically without keys.
